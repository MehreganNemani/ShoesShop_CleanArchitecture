@model CategoryEditVM

@{
	ViewData["Title"] = "Edit Category";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	var parentCategories = ViewBag.ParentCategories as List<CategoryOptionDto> ?? new List<CategoryOptionDto>();
}

<h4>@ViewData["Title"]</h4>
<hr />

<form asp-area="Admin" asp-controller="Category" asp-action="Edit" class="w-50 mx-auto mt-5 border rounded p-3" method="post">
	@Html.AntiForgeryToken()
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<input type="hidden" asp-for="Id" />
	<div class="form-group">
		<label asp-for="CategoryName" class="control-label">Category Name :</label>
		<input asp-for="CategoryName" class="form-control" />
		<span asp-validation-for="CategoryName" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Code" class="control-label">Category Code :</label>
		<input type="number" asp-for="Code" class="form-control" />
		<span asp-validation-for="Code" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="ParentId" class="form-label">Parent :</label>
		<select asp-for="ParentId" class="form-control">
			<option value="">Main Category...</option>
			@foreach (var category in parentCategories)
			{
				<option value="@category.Id">
					@category.CategoryName
				</option>
			}
		</select>
		<span asp-validation-for="ParentId" class="text-danger"></span>
	</div>
	<input type="submit" value="Edit" class="btn btn-outline-primary form-control mt-2" /> | <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Back</a>
</form> 