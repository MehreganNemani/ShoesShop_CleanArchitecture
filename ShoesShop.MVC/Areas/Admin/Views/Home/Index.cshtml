@model ShoesShop.MVC.Models.PaginatedViewModel<ProductVM>

@{
	ViewData["Title"] = "Product Management";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int rowNumbers = 1;
}

<h4>@ViewData["Title"]</h4>
<a asp-area="Admin" asp-controller="Home" asp-action="Create" class="btn btn-outline-primary">Create</a>
<hr />
@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"]
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}

<form asp-area="Admin" asp-controller="Home" asp-action="Index" method="get" class="row g-2 mb-3">
	<div class="col-md-8">
		<input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search By Name , Model , Code..." />
	</div>
	<div class="col-md-4">

		<button type="submit" class="btn btn-secondary">Search...</button>
		<a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-primary">Reset</a>

	</div>
</form>
<div class="table-responsive-md">
	<table class="table table-dark table-striped-columns table-hover table-bordered">
		<thead>
			<tr>
				<th>
					Rows
				</th>
				<th>
					Product Name
				</th>
				<th>
					Product Code
				</th>
				<th>
					Product Model
				</th>
				<th>
					Product Price
				</th>
				<th>
					Create Date
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Items)
			{
				<tr>
					<td>
						@rowNumbers
					</td>
					<td>
						@item.ProductName
					</td>
					<td>
						@item.ProductCode
					</td>
					<td>
						@item.ProductModel
					</td>
					<td>
						@item.ProductPrice
					</td>
					<td>
						@item.CreateDate.ToString("yyyy/MM/dd")
					</td>
					<td>
						<a asp-area="Admin" asp-controller="Home" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning text-white">Edit</a>
						<a asp-area="Admin" asp-controller="Home" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger text-white">Remove</a>
						<a asp-area="Admin" asp-controller="ProductColor" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-outline-primary text-white">Colors</a>
						<a asp-area="Admin" asp-controller="ProductCategory" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-outline-info text-white">Categories</a>
						<a asp-area="Admin" asp-controller="Gallery" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-outline-secondary text-white">Images</a>
						<a asp-area="Admin" asp-controller="ProductTag" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-outline-dark text-white">Tags</a>
						<a asp-area="Admin" asp-controller="ProductSize" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-outline-info text-white">Sizes</a>
					</td>
				</tr>
				rowNumbers += 1;
			}
		</tbody>
	</table>
</div>

@if (Model.TotalPages > 1)
{
	<nav>
		<ul class="pagination">
			@for (var i = 1; i <= Model.TotalPages; i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">
						@i
					</a>
				</li>
			}
		</ul>
	</nav>
}