@model TagVM

@{
	ViewData["Title"] = "Remove Tag";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h4>@ViewData["Title"]</h4>
<hr />

<div class="alert alert-warning">
	Are You Sure You Want To Delete @Model.TagTitle ?
</div>

<dl class="row">
	<dt class="col-sm-2">
		ID :
	</dt>
	<dd class="col-sm-10">
		@Model.Id
	</dd>
	<dt class="col-sm-2">
		Tag Title :
	</dt>
	<dd class="col-sm-10">
		@Model.TagTitle
	</dd>
</dl>

<form asp-area="Admin" asp-controller="Tag" asp-action="Delete" method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" name="Id" value="@Model.Id" />
	<button type="submit" class="btn btn-danger">Remove</button> | <a asp-area="Admin" asp-controller="Tag" asp-action="Index" class="btn btn-secondary">Go Back</a>
</form>