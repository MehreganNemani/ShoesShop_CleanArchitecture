@model ShoesShop.MVC.Models.PaginatedViewModel<TagVM>
@{
	ViewData["Title"] = "Tag Management";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int rowNumbers = 1;
}

<h4>@ViewData["Title"]</h4>
<a asp-area="Admin" asp-controller="Tag" asp-action="Create" class="btn btn-outline-primary">Create</a>
<hr />
@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"]
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}

<form asp-area="Admin" asp-controller="Tag" asp-action="Index" method="get" class="row g-2 mb-3">
	<div class="col-md-8">
		<input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search..." />
	</div>
	<div class="col-md-4">

		<button type="submit" class="btn btn-secondary">Search...</button>
		<a asp-area="Admin" asp-controller="Tag" asp-action="Index" class="btn btn-primary">Reset</a>

	</div>
</form>
<div class="table-responsive-md">
	<table class="table table-dark table-striped-columns table-hover table-bordered">
		<thead>
			<tr>
				<th>
					Rows
				</th>
				<th>
					Tag Title
				</th>
				<th>
					Create Date
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Items)
			{
				<tr>
					<td>
						@rowNumbers
					</td>
					<td>
						@item.TagTitle
					</td>
					<td>
						@item.CreateDate.ToString("yyyy/MM/dd")
					</td>
					<td>
						<a asp-area="Admin" asp-controller="Tag" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning text-white">Edit</a>
						<a asp-area="Admin" asp-controller="Tag" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger text-white">Remove</a>
					</td>
				</tr>
				rowNumbers += 1;
			}
		</tbody>
	</table>
</div>

@if (Model.TotalPages > 1)
{
	<nav>
		<ul class="pagination">
			@for (var i = 1; i <= Model.TotalPages; i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" asp-area="Admin" asp-controller="Tag" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">
						@i
					</a>
				</li>
			}
		</ul>
	</nav>
}