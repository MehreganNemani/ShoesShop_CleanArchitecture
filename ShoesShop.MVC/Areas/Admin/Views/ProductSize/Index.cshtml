@model ProductSizeIndexVM
@{
	ViewData["Title"] = "Product Sizes Management";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int rowNumbers = 1;
}

<h4>@ViewData["Title"]</h4>
<hr />
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"]
	</div>
}

@if (Model.ProductInfo != null)
{
	<div class="card mb-3">
		<div class="card-body">
			<h5 class="card-title">
				Product Name => @Model.ProductInfo.ProductName
			</h5>
			<p class="card-text">
				Product Code => @Model.ProductInfo.ProductCode
			</p>
		</div>
	</div>
}

<div class="container mt-4">
	<h4>Add New Size</h4>
	<form asp-area="Admin" asp-controller="ProductSize" asp-action="Add" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" name="productId" value="@Model.ProductID" />
		<div class="row">
			<div class="col-md-5">
				<select name="sizeId" class="form-select" required>
					<option value="">
						Select Size
					</option>
					@foreach (var size in Model.AvailableSizes)
					{
						<option value="@size.Id">
							@size.SizeNumber
						</option>
					}
				</select>
			</div>
			<div class="col-md-3">
				<button type="submit" class="btn btn-outline-primary">Add</button>
			</div>
		</div>
	</form>
	<hr />
	<h4>Product Sizes That Has Been Selected...</h4>
	@if (Model.ProductSizes == null || !Model.ProductSizes.Any())
	{
		<div class="alert alert-warning">
			There Is No Size For This Product...
		</div>
	}
	else
	{
		<div class="table-responsive-md">
			<table class="table table-dark table-striped-columns table-hover table-bordered">
				<thead>
					<tr>
						<th>
							Rows
						</th>
						<th>
							Size ID
						</th>
						<th>
							Size Number
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.ProductSizes)
					{
						<tr>
							<td>
								@rowNumbers
							</td>
							<td>
								@item.SizeID
							</td>
							<td>
								@item.SizeNumber
							</td>
							<td>
								<form asp-area="Admin" asp-controller="ProductSize" asp-action="Remove" method="post"
									  onsubmit="return confirm('Are You Sure You Want To Delete This Size From Product?')">
									@Html.AntiForgeryToken()
									<input type="hidden" name="productId" value="@Model.ProductID" />
									<input type="hidden" name="sizeId" value="@item.SizeID" />
									<button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
								</form>
							</td>
						</tr>
						rowNumbers += 1;
					}
				</tbody>
			</table>
		</div>

	}
</div>