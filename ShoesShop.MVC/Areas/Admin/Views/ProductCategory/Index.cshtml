@model ProductCategoryVM

@{
	ViewData["Title"] = "Product Categories Management";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	int rowNumbers = 1;
}

<h4>@ViewData["Title"]</h4>
<hr />

<input type="hidden" id="ProductId" value="@Model.ProductId" />

<div class="mb-3">
	<label for="ParentCategoryId" class="form-label">
		Parent Category
	</label>
	<select id="ParentCategoryId" class="form-select">
		<option value="">
			Select Parent Category
		</option>
		@foreach (var item in Model.ParentCategories)
		{
			<option value="@item.Value">
				@item.Text
			</option>
		}
	</select>
</div>

<div class="mb-3">
	<label for="ChildCategoryId" class="form-label">
		Child Category
	</label>
	<select id="ChildCategoryId" name="ChildCategoryId" class="form-select" disabled>
		<option value="">
			Please Select Parent Category First!
		</option>
	</select>
</div>

<button type="button" id="btnAdd" class="btn btn-outline-primary">Add</button>
<hr />

<h4>Product Categories</h4>

<div class="table-responsive-md">
	<table class="table table-dark table-striped-columns table-hover table-bordered">
		<thead>
			<tr>
				<th>
					Rows
				</th>
				<th>
					Category Name
				</th>
				<th></th>
			</tr>
		</thead>
		<tbody id="productCategories">
			@foreach (var item in Model.ProductCategories)
			{
				<tr>
					<td>
						@rowNumbers
					</td>
					<td>
						@item.CategoryName
					</td>
					<td>
						<button type="button" class="btn btn-danger btn-sm btnRemove" data-category-id="@item.CategoryId">
							Remove
						</button>
					</td>
				</tr>
				rowNumbers += 1;
			}
		</tbody>
	</table>
</div>

@section AdminScripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const parentSelect = document.getElementById('ParentCategoryId');
			const childSelect = document.getElementById('ChildCategoryId');
			parentSelect.addEventListener("change", async function () {
				const parentId = parentSelect.value;
				childSelect.innerHTML = "";
				if (!parentId) {
					childSelect.disabled = true;
					childSelect.add(new Option("Please Select Parent Category...", ""));
					return;
				}

				childSelect.disabled = true;
				childSelect.add(new Option("Loading...", ""));

				try {
					const response = await fetch('/Admin/ProductCategory/GetChildCategories?parentId=' + encodeURIComponent(parentId));

					console.log("Response Status:", response.status);

					if (!response.ok) {
						throw new Error("Loading Child Information Failed...");
					}

					const categories = await response.json();

					console.log("Categories", categories);

					childSelect.innerHTML = "";

					childSelect.add(new Option("Please Select Child Category...", ""));

					categories.forEach(function (category) {
						childSelect.add(new Option(category.name, category.id));
					});

					childSelect.disabled = categories.length === 0;

					if (categories.length === 0) {
						childSelect.innerHTML = "";
						childSelect.add(new Option("There Is No Child...", ""));
					}
				}
				catch (error) {
					childSelect.innerHTML = "";
					childSelect.add(new Option("Loading Information Failed...", ""));
					console.log(error);
				}
			});
		});

		const addButton = document.getElementById("btnAdd");

		addButton.addEventListener("click", async function () {
			const parentSelect = document.getElementById("ParentCategoryId");
			const childSelect = document.getElementById("ChildCategoryId");
			const productId = Number(document.getElementById("ProductId").value);
			const parentCategoryId = Number(parentSelect.value);
			const childCategoryId = Number(childSelect.value);

			if (!parentCategoryId || !childCategoryId) {
				alert("Please Select Child And Parent Items...");
				return;
			}

			addButton.disabled = true;

			try {
				const response = await fetch("/Admin/ProductCategory/Add", {
					method: "POST",
					headers: {
						"Content-Type": "application/json"
					},
					body: JSON.stringify({
						ProductId: productId,
						ParentCategoryId: parentCategoryId,
						ChildCategoryId: childCategoryId
					})
				});

				if (!response.ok) {
					const message = await response.text();
					alert(message || "Add New Category to Product Failed...");
					return;
				}

				const message = await response.text();
				alert(message || "Add Category To Product Successfully...");
				location.reload();

			} catch (error) {
				console.error(error);
				alert("We Could Not Connect To Server...");
			}
			finally {
				addButton.disabled = false;
			}
		});

		document.querySelectorAll(".btnRemove").forEach(function (button) {
			button.addEventListener("click", async function () {
				const categoryId = Number(button.dataset.categoryId);
				const productId = Number(document.getElementById("ProductId").value);
				if (!confirm("Are You Sure You Want To Remove This Relation?")) {
					return;
				}

				button.disabled = true;

				try {
					const response = await fetch('/Admin/ProductCategory/Remove?productId=' + encodeURIComponent(productId) + '&categoryId=' + encodeURIComponent(categoryId), { method: "POST" });

					if (!response.ok) {
						alert("Remove Relation Between Category And Product Failed...");
						return;
					}

					alert("Remove Relation Between Category And Product Successfully...");

					location.reload();
				}
				catch (error) {
					console.error(error);
					alert("We Could Not Connect To Server...");
				}
				finally {
					button.disabled = false;
				}
			});
		});

	</script>
}