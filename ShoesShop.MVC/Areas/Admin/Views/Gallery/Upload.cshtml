@model GalleryIndexVM

@{
	ViewData["Title"] = "Upload Image For Products";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h4>Product Name : @Model.ProductName</h4>
<h4>Product Code : @Model.ProductCode</h4>
<hr />

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">
		@TempData["Error"]
	</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-success">
		@TempData["Success"]
	</div>
}

@if (!ViewData.ModelState.IsValid)
{
	<div class="alert alert-danger">
		@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
		{
			<div>
				@error.ErrorMessage
			</div>
		}
	</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-area="Admin" asp-controller="Gallery" asp-action="Upload" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()
	<input type="hidden" name="productId" value="@Model.ProductId" />
	<div class="mb-3">
		<lable for="images" class="form-label">
			Images
		</lable>
		<input type="file" id="images" name="images" class="form-control" accept=".jpg,.jpeg,.png" multiple required />
	</div>
	<button type="submit" class="btn btn-success">
		Save Image
	</button>
	<a asp-area="Admin" asp-controller="Gallery" asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">Go Back</a>
</form>